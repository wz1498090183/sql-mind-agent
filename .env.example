# ============================================================
# SQL Mind Agent 环境变量模板
# 使用：cp .env.example .env 后按需修改
# 说明：Docker Compose 读取本文件注入容器；部分变量在容器内由 compose 覆盖
# ============================================================

# ---------- 模型推理开关 ----------
# false=远端 API（默认，无 GPU 也能跑）；true=本地 vLLM 容器
USE_LOCAL_MODEL=false

# ---------- 远端 API（默认链路，DeepSeek / OpenAI 兼容） ----------
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ---------- 本地 vLLM（USE_LOCAL_MODEL=true 时生效） ----------
LOCAL_LLM_API_KEY=EMPTY
# 容器内通过服务名访问 vllm:8000；本地非容器调试改为 http://localhost:8000/v1
LOCAL_LLM_BASE_URL=http://vllm:8000/v1
LOCAL_LLM_MODEL=Qwen2.5-Coder-3B-Instruct

# ---------- LLM 单次调用超时（秒） ----------
LLM_REQUEST_TIMEOUT=60

# ---------- 请求 / 子任务超时（秒） ----------
REQUEST_TIMEOUT_SEC=120
SUBTASK_TIMEOUT_SEC=30

# ---------- Spider 数据库路径 ----------
# 容器内由 compose 覆盖为 /app/spider_data/database；本地运行时相对路径按仓库根解析
SPIDER_DB_ROOT=./spider_data/database

# ---------- vLLM 服务配置 ----------
VLLM_MODEL_NAME=Qwen2.5-Coder-3B-Instruct
VLLM_MODEL_PATH=/models/Qwen2.5-Coder-3B-Instruct
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.9
# HuggingFace Token（私有模型需要，公开模型留空）
HF_TOKEN=

# ---------- 端口映射 ----------
FRONTEND_PORT=8080
BACKEND_PORT=8000
VLLM_PORT=8001

# ---------- 宿主机模型目录（挂载到 vllm / grpo-train 容器内 /models） ----------
HOST_MODELS_DIR=./models
