# ============================================================
# SQL Mind Agent 环境配置模板
# 使用方法:
#   1. 复制本文件并重命名为 .env:
#      cp .env.example .env   (macOS / Linux)
#      copy .env.example .env (Windows)
#   2. 修改为你的实际配置
# ============================================================

# —— LLM API 配置 ——
# 支持 OpenAI / DeepSeek / 本地 vLLM 等兼容接口
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# LLM 单次调用超时秒数（默认 60s）
LLM_REQUEST_TIMEOUT=60

# —— 本地模型开关（后续 GRPO 微调模型接入时启用） ——
# 改为 true 时使用 vLLM / Ollama 本地模型
USE_LOCAL_MODEL=false

# —— Spider 数据库路径 ——
# 指向 Spider 数据集的 database 目录
SPIDER_DB_ROOT=./spider/database

# —— 请求超时 ——
# 整体请求超时秒数（API 层面，默认 120s）
REQUEST_TIMEOUT_SEC=120
# 单个子任务超时秒数（默认 30s）
SUBTASK_TIMEOUT_SEC=30
