# ============================================================
# SQL Mind Agent 环境配置模板
# 使用方法:
#   1. 复制本文件并重命名为 .env:
#      cp .env.example .env   (macOS / Linux)
#      copy .env.example .env (Windows)
#   2. 修改为你的实际配置
# ============================================================

# —— 远端 API 模型 ——
# 支持 OpenAI / DeepSeek 等兼容接口
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# LLM 单次调用超时秒数（默认 60s）
LLM_REQUEST_TIMEOUT=60

# —— 本地 vLLM 模型（USE_LOCAL_MODEL=true 时使用） ——
# vLLM 以 OpenAI 兼容接口对外服务，通常为 GRPO 微调后的 Qwen 模型
# 无鉴权时 LOCAL_LLM_API_KEY 用 EMPTY 占位即可
LOCAL_LLM_API_KEY=EMPTY
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=Qwen2.5-Coder-3B-Instruct

# —— 模型切换开关 ——
# true 时使用本地 vLLM 模型，false 时使用远端 API 模型
USE_LOCAL_MODEL=false

# —— Spider 数据库路径 ——
# 指向 Spider 数据集的 database 目录
SPIDER_DB_ROOT=./spider/database

# —— 请求超时 ——
# 整体请求超时秒数（API 层面，默认 120s）
REQUEST_TIMEOUT_SEC=120
# 单个子任务超时秒数（默认 30s）
SUBTASK_TIMEOUT_SEC=30
